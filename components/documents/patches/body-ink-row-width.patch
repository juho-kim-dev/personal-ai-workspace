+    /// Validate complete logical coverage and measure each row independently.
+    /// A spanning cell contributes its width once to every row it occupies.
+    /// Explicit widths permit resize preflight before any model mutation.
+    /// This helper does not infer shared column boundaries or change cells.
+    pub(crate) fn checked_max_complete_row_width_hu(
+        &self,
+        widths: &[HwpUnit],
+    ) -> Result<HwpUnit, String> {
+        let rows = usize::from(self.row_count);
+        let cols = usize::from(self.col_count);
+        let slots = rows.checked_mul(cols)
+            .ok_or_else(|| "Table coverage size overflow".to_string())?;
+        if rows == 0 || cols == 0 || slots > MAX_TABLE_GRID_CELLS
+            || self.cells.is_empty() || self.cells.len() > slots
+            || widths.len() != self.cells.len()
+        {
+            return Err("Unsupported or incomplete table coverage".to_string());
+        }
+        let mut occupied = vec![false; slots];
+        let mut totals = vec![0u64; rows];
+        for (cell, &width) in self.cells.iter().zip(widths) {
+            let row = usize::from(cell.row);
+            let col = usize::from(cell.col);
+            let row_end = row.checked_add(usize::from(cell.row_span))
+                .ok_or_else(|| "Cell row range overflow".to_string())?;
+            let col_end = col.checked_add(usize::from(cell.col_span))
+                .ok_or_else(|| "Cell column range overflow".to_string())?;
+            if cell.row_span == 0 || cell.col_span == 0
+                || row_end > rows || col_end > cols
+                || width == 0 || width > i32::MAX as u32
+            {
+                return Err("Invalid cell bounds or width".to_string());
+            }
+            for y in row..row_end {
+                totals[y] = totals[y].checked_add(u64::from(width))
+                    .ok_or_else(|| "Cell row width overflow".to_string())?;
+                if totals[y] > i32::MAX as u64 {
+                    return Err("Cell row width exceeds signed layout range".to_string());
+                }
+                for x in col..col_end {
+                    let slot = y * cols + x;
+                    if occupied[slot] {
+                        return Err("Overlapping table cells".to_string());
+                    }
+                    occupied[slot] = true;
+                }
+            }
+        }
+        if occupied.iter().any(|present| !present) {
+            return Err("Uncovered table slots".to_string());
+        }
+        Ok(totals.into_iter().max().unwrap_or(0) as HwpUnit)
+    }
+
