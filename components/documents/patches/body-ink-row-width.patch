+use super::render_tree::BoundingBox;
+
+pub(crate) fn finite_positive_box(b: BoundingBox) -> bool {
+    [b.x, b.y, b.width, b.height, b.x + b.width, b.y + b.height]
+        .into_iter()
+        .all(f64::is_finite)
+        && b.width > 0.0
+        && b.height > 0.0
+}
+
+/// Additional clip area for one measured, fill-only glyph. The caller unions
+/// this with the unchanged strict Body rectangle for that glyph alone.
+/// Layout geometry grants eligibility; measured Canvas ink grants extent.
+pub(crate) fn body_top_ink_extension(
+    body: BoundingBox,
+    logical_glyph: BoundingBox,
+    ink: BoundingBox,
+) -> Option<BoundingBox> {
+    if !finite_positive_box(body)
+        || !finite_positive_box(logical_glyph)
+        || !finite_positive_box(ink)
+        || !body.contains(&logical_glyph)
+        || ink.y >= body.y
+    {
+        return None;
+    }
+    let left = ink.x.max(body.x);
+    let right = (ink.x + ink.width).min(body.x + body.width);
+    let extension = BoundingBox::new(left, ink.y, right - left, body.y - ink.y);
+    finite_positive_box(extension).then_some(extension)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn body() -> BoundingBox {
+        BoundingBox::new(10.0, 132.26666666666668, 300.0, 400.0)
+    }
+
+    fn glyph() -> BoundingBox {
+        BoundingBox::new(20.0, body().y, 12.0, 16.0)
+    }
+
+    fn ink() -> BoundingBox {
+        BoundingBox::new(19.0, 131.1999969482422, 14.0, 15.0)
+    }
+
+    #[test]
+    fn measured_top_only_without_padding() {
+        let extension = body_top_ink_extension(body(), glyph(), ink()).unwrap();
+        assert_eq!(extension.x, ink().x);
+        assert_eq!(extension.y, ink().y);
+        assert_eq!(extension.width, ink().width);
+        assert_eq!(extension.height, body().y - ink().y);
+        assert_eq!(extension.y + extension.height, body().y);
+    }
+
+    #[test]
+    fn layout_crossing_any_body_edge_remains_strict() {
+        let b = body();
+        for logical in [
+            BoundingBox::new(b.x - 1.0, b.y, 12.0, 16.0),
+            BoundingBox::new(b.x, b.y - 1.0, 12.0, 16.0),
+            BoundingBox::new(b.x + b.width - 11.0, b.y, 12.0, 16.0),
+            BoundingBox::new(b.x, b.y + b.height - 15.0, 12.0, 16.0),
+        ] {
+            assert!(body_top_ink_extension(b, logical, ink()).is_none());
+        }
+    }
+
+    #[test]
+    fn extension_keeps_logical_body_horizontal_limits() {
+        let b = body();
+        let wide = BoundingBox::new(b.x - 10.0, ink().y, b.width + 20.0, 15.0);
+        let extension = body_top_ink_extension(b, glyph(), wide).unwrap();
+        assert_eq!(extension.x, b.x);
+        assert_eq!(extension.width, b.width);
+        assert_eq!(extension.y + extension.height, b.y);
+    }
+
+    #[test]
+    fn no_top_overhang_remains_strict() {
+        let at_edge = BoundingBox::new(20.0, body().y, 12.0, 15.0);
+        assert!(body_top_ink_extension(body(), glyph(), at_edge).is_none());
+    }
+
+    #[test]
+    fn invalid_and_empty_geometry_remains_strict() {
+        for bad in [
+            BoundingBox::new(f64::NAN, 131.0, 12.0, 15.0),
+            BoundingBox::new(20.0, f64::NEG_INFINITY, 12.0, 15.0),
+            BoundingBox::new(20.0, 131.0, 0.0, 15.0),
+            BoundingBox::new(20.0, 131.0, 12.0, -1.0),
+            BoundingBox::new(f64::MAX, 131.0, f64::MAX, 15.0),
+        ] {
+            assert!(body_top_ink_extension(body(), glyph(), bad).is_none());
+            assert!(body_top_ink_extension(body(), bad, ink()).is_none());
+            assert!(body_top_ink_extension(bad, glyph(), ink()).is_none());
+        }
+    }
+}
