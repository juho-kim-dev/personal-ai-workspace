+//! Regression source for intentional resize and explicit declaration repair.
+//! Native command tests are separate from browser/Canvas/Hancom acceptance.
+
+use super::CellResizeUpdate;
+use crate::document_core::DocumentCore;
+use crate::model::control::Control;
+use crate::model::document::{Document, Section};
+use crate::model::paragraph::Paragraph;
+use crate::model::shape::{common_obj_offsets, SizeCriterion};
+use crate::model::table::{Cell, Table};
+
+fn grid(rows: u16, columns: u16, width: u32) -> Table {
+    let mut table = Table {
+        row_count: rows,
+        col_count: columns,
+        row_sizes: vec![columns as i16; rows as usize],
+        ..Default::default()
+    };
+    for row in 0..rows {
+        for col in 0..columns {
+            table.cells.push(Cell::new_empty(col, row, width, 1000, 0));
+        }
+    }
+    table.common.width_criterion = SizeCriterion::Absolute;
+    table.raw_ctrl_data = vec![0; 36];
+    table.update_ctrl_dimensions();
+    table.rebuild_grid();
+    table
+}
+
+fn core_with(table: Table) -> DocumentCore {
+    let mut host = Paragraph::new_empty();
+    host.controls.push(Control::Table(Box::new(table)));
+    let mut section = Section::default();
+    section.paragraphs.push(host);
+    let mut document = Document::default();
+    document.sections.push(section);
+    let mut core = DocumentCore::new_empty();
+    core.set_document(document);
+    core
+}
+
+fn table(core: &DocumentCore) -> &Table {
+    match &core.document.sections[0].paragraphs[0].controls[0] {
+        Control::Table(table) => table,
+        _ => panic!("fixture table missing"),
+    }
+}
+
+fn table_mut(core: &mut DocumentCore) -> &mut Table {
+    match &mut core.document.sections[0].paragraphs[0].controls[0] {
+        Control::Table(table) => table,
+        _ => panic!("fixture table missing"),
+    }
+}
+
+fn snapshot(table: &Table) -> serde_json::Value {
+    serde_json::to_value(table).unwrap()
+}
+
+fn widths(table: &Table) -> Vec<u32> {
+    table.cells.iter().map(|c| c.width).collect()
+}
+
+fn extent(table: &Table) -> Result<u32, String> {
+    table.checked_max_complete_row_width_hu(&widths(table))
+}
+
+fn raw_width(table: &Table) -> u32 {
+    u32::from_le_bytes(table.raw_ctrl_data[common_obj_offsets::WIDTH].try_into().unwrap())
+}
+
+fn merged_fixture() -> Table {
+    let mut table = grid(4, 3, 13984);
+    table.merge_cells(0, 0, 0, 1).unwrap();
+    table.merge_cells(1, 0, 2, 0).unwrap();
+    table
+}
+
+fn update(index: usize, width_delta: i32, height_delta: i32) -> CellResizeUpdate {
+    CellResizeUpdate { cell_idx: index, width_delta, height_delta }
+}
+
+#[test]
+fn new_native_merge_then_resize_preserves_intent_and_declares_42852() {
+    let mut core = core_with(grid(4, 3, 13984));
+    core.merge_table_cells_native(0, 0, 0, 0, 0, 0, 1).unwrap();
+    core.merge_table_cells_native(0, 0, 0, 1, 0, 2, 0).unwrap();
+    let before = widths(table(&core));
+    assert_eq!(before[0], 27968);
+    assert_eq!(table(&core).common.width, 41952);
+    core.resize_table_cells_native(0, 0, 0,
+        r#"[{"cellIdx":0,"widthDelta":900,"heightDelta":600}]"#).unwrap();
+    let result = table(&core);
+    assert_eq!(result.cells[0].width, 28868);
+    assert_eq!(&widths(result)[1..], &before[1..]);
+    assert_eq!(result.cells.len(), 10);
+    assert_eq!(extent(result).unwrap(), 42852);
+    assert_eq!(result.common.width, 42852);
+    assert_eq!(raw_width(result), 42852);
+    let props: serde_json::Value = serde_json::from_str(
+        &core.get_table_properties_native(0, 0, 0).unwrap()).unwrap();
+    assert_eq!(props["tableWidth"], 42852);
+    assert!(props.get("width").is_none());
+}
+
+#[test]
+fn negative_and_height_only_changes_preserve_original_width() {
+    for delta in [-600, 600] {
+        let mut table = merged_fixture();
+        table.cells[0].width = 28868;
+        let original_widths = widths(&table);
+        DocumentCore::apply_cell_resize_updates(&mut table, &[update(0, 0, delta)]).unwrap();
+        assert_eq!(widths(&table), original_widths);
+        assert_eq!(table.common.width, 41952);
+        assert_eq!(raw_width(&table), 41952);
+    }
+}
+
+#[test]
+fn zero_empty_invalid_index_and_cancelled_same_cell_are_model_noops() {
+    for updates in [
+        vec![],
+        vec![update(0, 0, 0)],
+        vec![update(usize::MAX, 900, 600)],
+        vec![update(0, 900, 600), update(0, -900, -600)],
+    ] {
+        let mut table = merged_fixture();
+        table.cells[0].width = 28868;
+        let before = snapshot(&table);
+        assert!(DocumentCore::apply_cell_resize_updates(&mut table, &updates).unwrap().is_empty());
+        assert_eq!(snapshot(&table), before);
+    }
+}
+
+#[test]
+fn native_zero_delta_keeps_legacy_declaration_and_cells() {
+    let mut fixture = merged_fixture();
+    fixture.cells[0].width = 28868;
+    let mut core = core_with(fixture);
+    let before = snapshot(table(&core));
+    core.resize_table_cells_native(0, 0, 0,
+        r#"[{"cellIdx":0,"widthDelta":0,"heightDelta":0}]"#).unwrap();
+    assert_eq!(snapshot(table(&core)), before);
+}
+
+#[test]
+fn negative_width_resize_recomputes_maximum_without_changing_other_cells() {
+    let mut table = merged_fixture();
+    table.cells[0].width = 28868;
+    table.sync_ctrl_width(42852);
+    let original = widths(&table);
+    DocumentCore::apply_cell_resize_updates(&mut table, &[update(0, -900, 0)]).unwrap();
+    assert_eq!(table.cells[0].width, 27968);
+    assert_eq!(&widths(&table)[1..], &original[1..]);
+    assert_eq!(table.common.width, 41952);
+}
+
+#[test]
+fn unequal_rows_do_not_use_global_column_maxima() {
+    let mut table = grid(2, 3, 13984);
+    for (cell, width) in table.cells.iter_mut().zip([
+        18769, 9199, 13984,
+        9000, 18000, 14952,
+    ]) {
+        cell.width = width;
+    }
+    assert_eq!(extent(&table).unwrap(), 41952);
+    assert_eq!(table.get_column_widths().iter().copied().sum::<u32>(), 51721);
+    let original = widths(&table);
+    DocumentCore::apply_cell_resize_updates(&mut table, &[update(0, 900, 0)]).unwrap();
+    assert_eq!(table.common.width, 42852);
+    assert_eq!(&widths(&table)[1..], &original[1..]);
+}
+
+#[test]
+fn opposing_changes_in_different_rows_are_not_a_noop() {
+    let mut table = grid(2, 2, 1000);
+    let reflow = DocumentCore::apply_cell_resize_updates(
+        &mut table, &[update(0, 100, 0), update(2, -100, 0)]).unwrap();
+    assert_eq!(widths(&table), vec![1100, 1000, 900, 1000]);
+    assert_eq!(table.common.width, 2100);
+    assert_eq!(reflow.len(), 2);
+}
+
+#[test]
+fn both_spans_count_cell_width_once_per_occupied_row() {
+    let mut table = grid(2, 3, 1000);
